rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Collection: users ────────────────────────────────────
    match /users/{userId} {

      // Cualquier usuario autenticado puede leer y escribir
      // su PROPIO documento (para actualizar estadísticas)
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // El administrador puede leer CUALQUIER documento de la colección
      allow read: if request.auth != null
                  && request.auth.token.email == "bernatcosta@iesamachado.org";

      // Creación del propio documento al registrarse
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                         "email",
                         "displayName",
                         "partidasJugadas",
                         "partidasGanadas"
                       ])
                    && request.resource.data.partidasJugadas == 0
                    && request.resource.data.partidasGanadas == 0;

      // Actualización: el usuario solo puede modificar sus contadores,
      // no alterar email ni displayName
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.displayName == resource.data.displayName;
    }

    // ─── Bloquear todo lo demás por defecto ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
